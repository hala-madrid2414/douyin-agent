# LLM API Configuration
# Your API Key for DashScope or other compatible provider
DASHSCOPE_API_KEY=your_api_key_here

# (Optional) The base URL for the API. Defaults to DashScope's compatible mode.
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# (Optional) The model to use. Defaults to qwen3-max.
# LLM_MODEL=qwen3-max
