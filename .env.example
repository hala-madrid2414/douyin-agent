# LLM API Configuration
# Your API Key for DashScope or other compatible provider
DASHSCOPE_API_KEY=your_api_key_here

# (Optional) The base URL for the API. Defaults to DashScope's compatible mode.
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# (Optional) The model to use. Defaults to qwen3-max.
# LLM_MODEL=qwen3-max


TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_MAX_RESULTS=5
# TAVILY_RETRY_TIMES=1
# TOOL_CALL_TIMEOUT=10000

# QWeather (HeWeather) API Configuration
# QWEATHER_CREDENTIAL_ID is optional for current public key mode.
# QWEATHER_CREDENTIAL_ID=your_qweather_credential_id_here
QWEATHER_API_KEY=your_qweather_api_key_here
QWEATHER_WEATHER_BASE_URL=https://devapi.qweather.com/v7
QWEATHER_GEO_BASE_URL=https://geoapi.qweather.com/v2
QWEATHER_TIMEOUT_MS=10000
QWEATHER_RETRY_TIMES=1
